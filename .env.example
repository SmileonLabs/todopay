# Runtime
NODE_ENV=production
HOST=0.0.0.0
PORT=8080
TRUST_PROXY=true

# Comma-separated public web origins. Never use * in production.
CORS_ORIGINS=https://admin.example.com

# Required in production: generate with a cryptographically secure random source.
SESSION_SECRET=replace-with-a-long-random-secret

# Data services
DATABASE_URL=postgresql://todopay:replace-me@postgres:5432/todopay
REDIS_URL=redis://redis:6379
REQUIRE_REDIS=true
PAYMENT_WORKER_CONCURRENCY=10

# Enable only after the PG adapter, signed webhook contract, and IP allowlist are ready.
PAYMENT_PROVIDER_ENABLED=false
PG_WEBHOOK_SECRET=replace-after-provider-onboarding

# Keep disabled until a Payment Intent trackId has been registered with KPPay
# and an end-to-end small-value test has verified the returned NOTI contract.
PAYMENT_INTENT_PG_TRACK_BINDING_ENABLED=false
# Requires the flag above plus WEBHOOK_DISPATCH_ENABLED and a configured merchant URL.
PAYMENT_INTENT_MERCHANT_WEBHOOK_ENABLED=false

# KPPay credentials: store real values only in AWS Secrets Manager.
KP_PAY_BASE_URL=https://api.kp-pay.com
KP_PAY_VIRTUAL_ACCOUNT_KEY=replace-with-kp-pay-virtual-account-key
KP_PAY_PAYOUT_KEY=replace-with-kp-pay-payout-key
KP_PAY_MERCHANT_ID=replace-with-kp-pay-merchant-id
