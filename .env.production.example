# Store real values in AWS Secrets Manager. Never commit production credentials.
NODE_ENV=production
PORT=8080
DATABASE_URL=postgresql://.../sellink
SESSION_SECRET=replace-with-a-random-64-character-secret
OTP_ENCRYPTION_KEY=replace-with-a-random-32-character-or-longer-key
CORS_ORIGINS=https://sellpartner.example
PUBLIC_APP_URL=https://sellpartner.example
TRUST_PROXY_HOPS=1
API_RATE_LIMIT_PER_MINUTE=600
LOGIN_RATE_LIMIT=10
LOGIN_RATE_WINDOW_SECONDS=900
SESSION_TTL_SECONDS=86400
JSON_BODY_LIMIT=256kb
FORM_BODY_LIMIT=64kb
WEBHOOK_BODY_LIMIT=64kb
REDIS_URL=rediss://replace-with-redis-endpoint:6379
REQUIRE_REDIS=true
PAYMENT_INTEGRATION_ENABLED=false
TODOPAY_API_BASE_URL=https://api.todopay.io
TODOPAY_API_KEY=replace-with-secrets-manager-reference
TODOPAY_WEBHOOK_SECRET=replace-with-a-random-32-character-or-longer-secret
TODOPAY_REQUEST_TIMEOUT_MS=15000
