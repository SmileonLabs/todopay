{
  "name": "@workspace/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts"
  },
  "scripts": {
    "push": "drizzle-kit push --config ./drizzle.config.ts",
    "push-force": "drizzle-kit push --force --config ./drizzle.config.ts",
    "migrate-production": "node ./scripts/apply-production-migrations.mjs",
    "backfill-merchant-fees": "node ./scripts/backfill-merchant-fees.mjs",
    "set-merchant-api-key": "node ./scripts/set-merchant-api-key.mjs",
    "set-merchant-allowed-ips": "node ./scripts/set-merchant-allowed-ips.mjs",
    "test:integration": "node ./scripts/run-financial-integration-tests.mjs",
    "test:load": "node ./scripts/run-financial-load-test.mjs"
  },
  "dependencies": {
    "drizzle-orm": "catalog:",
    "drizzle-zod": "^0.8.3",
    "pg": "^8.20.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/pg": "^8.18.0",
    "drizzle-kit": "^0.31.9"
  }
}
